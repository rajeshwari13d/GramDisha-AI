rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Scheme rules and local business data are read-only for clients
    match /schemeRules/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /localBusinessData/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    // Ground Vendor Survey data collection (SIH 2026)
    match /vendor_surveys/{surveyId} {
      allow read, write: if true;
    }
    // User / Credit Officer Appraisal Feedback
    match /appraisal_feedback/{feedbackId} {
      allow read, write: if true;
    }
    // Users can read/write only their own session-scoped documents
    match /users/{userId} {
      allow read, write: if true;
    }
    match /businessProfiles/{profileId} {
      allow read, write: if true;
    }
    match /analysisResults/{resultId} {
      allow read, write: if true;
    }
  }
}

